FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api

RUN npm install --workspace=@nfse-hub/nfse-types --workspace=@nfse-hub/fiscal-core --workspace=@nfse-hub/xml-engine --workspace=@nfse-hub/municipality-registry --workspace=@nfse-hub/api
RUN npm run build --workspace=@nfse-hub/nfse-types
RUN npm run build --workspace=@nfse-hub/fiscal-core
RUN npm run build --workspace=@nfse-hub/xml-engine
RUN npm run build --workspace=@nfse-hub/municipality-registry
RUN npm run prisma:generate --workspace=@nfse-hub/api
RUN npm run build --workspace=@nfse-hub/api

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

EXPOSE 3001
CMD ["sh", "-c", "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma || true && node apps/api/dist/main.js"]
